{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ryuzetsuran-map",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"migrations_dir": "drizzle",
			"database_name": "ryuzetsuran-map-db",
			"database_id": "72af47a0-c781-4830-b978-1a4934fe0090"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "ryuzetsuran-map-photos"
		}
	]
}